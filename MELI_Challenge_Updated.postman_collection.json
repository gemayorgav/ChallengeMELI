    {
      "name": "SEGURIDAD & VALIDACIÓN",
      "description": "Pruebas de seguridad y validación de autenticación",
      "item": [
        {
          "name": "1. Sin token - Debe fallar (401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": {
              "raw": "http://localhost:8080/api/v1/models/list",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "api",
                "v1",
                "models",
                "list"
              ]
            },
            "description": "Intenta acceder a endpoint protegido sin token JWT. Debe retornar 401 Unauthorized"
          },
          "response": []
        },
        {
          "name": "2. Token inválido - Debe fallar (401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer invalid.token.here"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": {
              "raw": "http://localhost:8080/api/v1/models/list",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "api",
                "v1",
                "models",
                "list"
              ]
            },
            "description": "Intenta acceder con token inválido. Debe retornar 401 Unauthorized"
          },
          "response": []
        },
        {
          "name": "3. Login fallido - Usuario no existe",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"usuarioinexistente\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/auth/login",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Intenta login con usuario que no existe. Debe retornar 401 Unauthorized con mensaje de error"
          },
          "response": []
        },
        {
          "name": "4. Login fallido - Contraseña incorrecta",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
