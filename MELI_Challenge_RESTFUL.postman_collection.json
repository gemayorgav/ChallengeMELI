    {
      "name": "SEGURIDAD & VALIDACIÓN",
      "description": "Pruebas de seguridad - Verificar que DELETE retorna 404 cuando modelo no existe",
      "item": [
        {
          "name": "1. Eliminar modelo inexistente - DELETE retorna 404",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
