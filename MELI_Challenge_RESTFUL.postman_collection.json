              "port": "8080",
              "path": [
                "api",
                "v1",
                "models"
              ]
            },
            "description": "Intenta eliminar modelo que no existe. Debe retornar 404 Not Found (NO 200 OK). Esto valida que DELETE verifica existencia."
          },
          "response": []
